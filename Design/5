<html lang="ko" vid="0"><head vid="1">
    <meta charset="UTF-8" vid="2">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" vid="3">
    <title vid="4">매물 상세 - Canis MLS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" vid="5">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" vid="6">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&amp;display=swap" rel="stylesheet" vid="7">
    <style vid="8">
        :root {
            --bg-color: #F9F8F6;
            --surface-color: #FFFFFF;
            --primary-accent: #D66023; 
            --text-main: #2D241E; 
            --text-muted: #7A726D;
            --border-light: #E8E5E1; 
            --radius-large: 24px; 
            --radius-medium: 12px; 
            --radius-pill: 100px;
            --spacing-xs: 4px;
            --spacing-sm: 8px;
            --spacing-md: 16px;
            --spacing-lg: 24px;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Noto Sans KR', sans-serif;
            background-color: var(--surface-color);
            color: var(--text-main);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .detail-container {
            max-width: 480px;
            margin: 0 auto;
            position: relative;
            padding-bottom: 100px;
        }

        
        .header-actions {
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            padding: 0 16px;
            z-index: 10;
        }

        .circle-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            color: var(--text-main);
        }

        
        .image-gallery {
            width: 100%;
            height: 300px;
            position: relative;
            background-color: #E0DCD8;
            background-image: url('https://images.unsplash.com/photo-1567496898669-ee935f5f647a?auto=format&fit=crop&w=800&q=80');
            background-size: cover;
            background-position: center;
        }

        .img-counter {
            position: absolute;
            bottom: 16px;
            right: 16px;
            background: rgba(0, 0, 0, 0.5);
            color: white;
            padding: 4px 12px;
            border-radius: var(--radius-pill);
            font-size: 0.7rem;
            font-weight: 500;
        }

        
        .content-section {
            padding: var(--spacing-lg) var(--spacing-md);
            border-bottom: 8px solid var(--bg-color);
        }

        .info-header {
            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);
        }

        .type-label {
            color: var(--primary-accent);
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 4px;
            display: block;
        }

        .main-price {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .main-address {
            font-size: 1rem;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .quick-specs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            background: var(--bg-color);
            padding: 16px;
            border-radius: var(--radius-medium);
        }

        .spec-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .spec-label {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .spec-val {
            font-size: 0.85rem;
            font-weight: 700;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 16px;
            display: block;
        }

        
        .details-list {
            width: 100%;
            border-collapse: collapse;
        }

        .details-list tr {
            border-bottom: 1px solid var(--border-light);
        }

        .details-list tr:last-child { border-bottom: none; }

        .details-list td {
            padding: 12px 0;
            font-size: 0.9rem;
        }

        .td-label {
            color: var(--text-muted);
            width: 100px;
        }

        .td-content {
            font-weight: 500;
        }

        
        .floor-plan-box {
            width: 100%;
            aspect-ratio: 4/3;
            background: #f0f0f0;
            border: 1px dashed var(--border-light);
            border-radius: var(--radius-medium);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        
        .amenity-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .amenity-tag {
            padding: 8px 14px;
            background: var(--bg-color);
            border-radius: var(--radius-pill);
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        
        .sticky-footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            max-width: 480px;
            background: var(--surface-color);
            padding: 12px 16px 32px;
            display: flex;
            gap: 12px;
            border-top: 1px solid var(--border-light);
            box-shadow: 0 -4px 10px rgba(0,0,0,0.03);
            z-index: 102;
        }

        .btn-outline {
            flex: 1;
            padding: 16px;
            border: 1px solid var(--border-light);
            border-radius: var(--radius-medium);
            background: white;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-fill {
            flex: 2;
            padding: 16px;
            background: var(--primary-accent);
            color: white;
            border: none;
            border-radius: var(--radius-medium);
            font-weight: 700;
            font-size: 1rem;
        }

        @media (min-width: 601px) {
            .detail-container { border-left: 1px solid var(--border-light); border-right: 1px solid var(--border-light); }
            .sticky-footer { max-width: 478px; }
        }
    </style>
</head>
<body vid="9">

