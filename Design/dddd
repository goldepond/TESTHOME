<html lang="ko" vid="0"><head vid="1">
    <meta charset="UTF-8" vid="2">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" vid="3">
    <title vid="4">Broker MLS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" vid="5">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" vid="6">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&amp;display=swap" rel="stylesheet" vid="7">
    <style vid="8">
        :root {
            
            --bg-base: #FAF8F5;
            --bg-surface: #FFFFFF;
            --text-primary: #2D2A26;
            --text-secondary: #8B7F74;
            --brand-primary: #D96B27;
            --brand-primary-hover: #c25f22;
            --border-subtle: #E5DFD5;
            --bg-input: transparent;
            --bg-pill-secondary: #EBE5DC;
            --text-pill-secondary: #5C5248;
            
            
            --bg-dark-surface: #1A1512;
            --text-dark-primary: #FFFFFF;
            --text-dark-secondary: rgba(255, 255, 255, 0.7);
            
            
            --radius-sm: 6px;
            --radius-md: 10px; 
            --radius-lg: 16px;
            --radius-pill: 999px; 
            
            
            --font-family: 'Noto Sans KR', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-base);
            color: var(--text-primary);
            -webkit-font-smoothing: antialiased;
            line-height: 1.5;
        }

        
        .app-container {
            max-width: 480px;
            margin: 0 auto;
            background-color: var(--bg-base);
            min-height: 100vh;
            position: relative;
            padding-bottom: 80px; 
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
        }

        
        .header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(250, 248, 245, 0.95);
            backdrop-filter: blur(8px);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: 18px;
            color: var(--text-primary);
            letter-spacing: -0.5px;
        }

        .brand-icon {
            width: 24px;
            height: 24px;
            background-color: var(--brand-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .brand-icon::after {
            content: '';
            width: 10px;
            height: 10px;
            background-color: var(--bg-base);
            border-radius: 50%;
        }

        .header-action {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-pill);
            background: var(--bg-pill-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        
        .search-container {
            padding: 4px 20px 16px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .input-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-secondary);
        }

        .search-input-wrapper {
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            background: var(--bg-surface);
            font-family: inherit;
            font-size: 15px;
            color: var(--text-primary);
            outline: none;
            transition: border-color 0.2s;
        }

        .search-input:focus {
            border-color: var(--brand-primary);
        }

        .search-input::placeholder {
            color: var(--border-subtle); 
        }

        
        .hero-match-card {
            margin: 0 20px 24px;
            background-color: var(--bg-dark-surface);
            background-image: radial-gradient(circle at bottom right, rgba(217, 107, 39, 0.25), transparent 70%);
            border-radius: var(--radius-lg);
            padding: 24px;
            color: var(--text-dark-primary);
            position: relative;
            overflow: hidden;
        }

        .hero-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--brand-primary);
            margin-bottom: 8px;
            display: block;
        }

        .hero-title {
            font-size: 22px;
            font-weight: 700;
            line-height: 1.3;
            letter-spacing: -0.5px;
            margin-bottom: 16px;
        }

        .hero-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-dark-secondary);
        }

        .hero-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--brand-primary);
            
        }

        
        .tabs-scroll {
            overflow-x: auto;
            scrollbar-width: none; 
            padding: 0 20px 16px;
            display: flex;
            gap: 8px;
        }
        
        .tabs-scroll::-webkit-scrollbar {
            display: none; 
        }

        .tab-btn {
            padding: 10px 20px;
            border-radius: var(--radius-pill);
            background: var(--bg-pill-secondary);
            color: var(--text-pill-secondary);
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            border: none;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: var(--brand-primary);
            color: #FFFFFF;
        }

        
        .feed-container {
            padding: 0 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        
        .property-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .card-image-area {
            height: 180px;
            background-color: #EBE5DC;
            position: relative;
            
            background-image: linear-gradient(45deg, var(--border-subtle) 25%, transparent 25%, transparent 75%, var(--border-subtle) 75%, var(--border-subtle)), 
                              linear-gradient(45deg, var(--border-subtle) 25%, transparent 25%, transparent 75%, var(--border-subtle) 75%, var(--border-subtle));
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
        }

        .badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(26, 21, 18, 0.8);
            color: #FFF;
            padding: 6px 12px;
            border-radius: var(--radius-pill);
            font-size: 11px;
            font-weight: 700;
            backdrop-filter: blur(4px);
        }

        .badge.urgent {
            background: var(--brand-primary);
        }

        .card-content {
            padding: 16px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 4px;
        }

        .price-title {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
        }

        .property-type {
            font-size: 13px;
            font-weight: 700;
            color: var(--brand-primary);
        }

        .address-text {
            font-size: 15px;
            color: var(--text-primary);
            margin-bottom: 12px;
        }

        
        .specs-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .spec-item {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .spec-item::before {
            content: '•';
            color: var(--border-subtle);
        }
        
        .spec-item:first-child::before {
            display: none;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .broker-info {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .broker-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--bg-pill-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-pill-secondary);
        }

        .broker-name {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-primary);
        }

        .action-btn {
            padding: 8px 16px;
            border-radius: var(--radius-pill);
            background: var(--bg-pill-secondary);
            color: var(--text-pill-secondary);
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            border: none;
            cursor: pointer;
        }

        
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            max-width: 480px;
            margin: 0 auto;
            background: rgba(250, 248, 245, 0.95);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border-subtle);
            display: flex;
            justify-content: space-around;
            padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
            z-index: 100;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 11px;
            font-weight: 700;
        }

        .nav-item.active {
            color: var(--brand-primary);
        }

        .nav-icon {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: 2px solid currentColor;
            opacity: 0.8;
        }

        .nav-item.active .nav-icon {
            background-color: currentColor;
            opacity: 1;
        }
        
        
        .fab {
            position: fixed;
            bottom: 80px; 
            right: 20px;
            background: var(--brand-primary);
            color: #fff;
            border: none;
            border-radius: var(--radius-pill);
            padding: 16px 24px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(217, 107, 39, 0.3);
            cursor: pointer;
            z-index: 99;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    </style>
</head>
